# Backend API (required for Vercel production build)
# VITE_BACKEND=https://sangam-b.onrender.com
VITE_BACKEND=http://localhost:3002

# Optional ML service
# VITE_BACKEND_ML=http://localhost:5000

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_VAPID_KEY=

# Third-party client keys (restrict by domain in provider console)
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_NEWS_API_KEY=
# VITE_WEATHER_API_KEY=

# Video conference app id only — never put server secrets in VITE_ vars
# VITE_appID=
